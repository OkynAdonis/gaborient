<%- include('partials/header', { title: 'Résultats — ORIENT 6ÈME', annee_courante: (typeof rapport !== 'undefined' && rapport.annee) ? rapport.annee : annee_courante }) %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 class="display" style="font-size:2rem; margin-bottom:0.4rem;">
      Résultats de la session <% if (rapport.annee) { %>— <%= rapport.annee %><% } %>
    </h1>
    <% if (!(typeof archive !== 'undefined' && archive)) { %>
    <p style="color:var(--encre-douce); margin:0;">
      Rapport officiel généré pour la campagne d'affectation en 6ème.
    </p>
    <% } %>
  </div>
  <div>
    <button onclick="window.print()" class="btn btn-primary" style="display:inline-flex; align-items:center; gap:0.5rem; cursor:pointer;">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6z"/></svg>
      Imprimer / Exporter le Rapport officiel
    </button>
  </div>
</div>

<% if (typeof archive !== 'undefined' && archive) { %>
<div style="background:rgba(217,146,46,0.15); color:#92600F; padding:0.9rem 1.25rem; border-radius:var(--rayon-petit); margin-bottom:1.5rem; font-weight:600;">
  Archive — année scolaire <%= rapport.annee || '?' %> (lecture seule)
</div>
<% } %>

<div class="releve">
  <div class="releve-item card card--gabon">
    <span class="chiffre"><%= rapport.resume.total_affectes %></span>
    <span class="intitule">Placés</span>
  </div>
  <div class="releve-item card card--gabon-blue">
    <span class="chiffre"><%= rapport.resume.total_liste_attente %></span>
    <span class="intitule">En attente</span>
  </div>
  <div class="releve-item card card--gabon-yellow">
    <span class="chiffre"><%= rapport.resume.total_non_affectes %></span>
    <span class="intitule">Sans attribution</span>
  </div>
  <div class="releve-item card card--gabon">
    <span class="chiffre"><%= rapport.resume.total_eleves %></span>
    <span class="intitule">Total dossiers</span>
  </div>
</div>

<h2 class="section-title">Taux de remplissage des établissements</h2>
<div class="card">
  <% rapport.etablissements.forEach(etab => { %>
  <div style="margin-bottom:1.1rem;">
    <div style="display:flex; justify-content:space-between; font-size:0.9rem;">
      <span><strong><%= etab.nom %></strong></span>
      <span><%= etab.places_occupees %>/<%= etab.capacite_6eme %> (<%= etab.taux_remplissage %>%)</span>
    </div>
    <div class="progress-track">
      <div class="progress-fill" style="width: <%= etab.taux_remplissage %>%;"></div>
    </div>
  </div>
  <% }) %>
</div>

<h2 class="section-title">Élèves affectés</h2>
<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Élève</th><th>Moyenne</th><th>Établissement</th><th>Distance</th></tr>
    </thead>
    <tbody>
      <% rapport.affectations.forEach(e => { %>
      <tr>
        <td><%= e.prenom %> <%= e.nom %></td>
        <td><%= e.moyenne_generale %>/20</td>
        <td><%= e.etablissement_affecte %></td>
        <td><%= e.distance_affectation_km %> km</td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (rapport.liste_attente && rapport.liste_attente.length > 0) { %>
<h2 class="section-title">Liste d'attente</h2>
<div class="table-wrap">
  <table>
    <thead><tr><th>Élève</th><th>Moyenne</th></tr></thead>
    <tbody>
      <% rapport.liste_attente.forEach(e => { %>
      <tr><td><%= e.prenom %> <%= e.nom %></td><td><%= e.moyenne_generale %>/20</td></tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('partials/footer') %>
