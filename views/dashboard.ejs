<%- include('partials/header', { title: 'Tableau de bord — ORIENT 6ÈME', annee_courante, currentPath: '/dashboard' }) %>

<div class="page-header">
  <div>
    <span class="eyebrow">Tableau de bord</span>
    <h1>Synthèse de la session</h1>
    <p>Récapitulatif et actions essentielles pour conduire le placement des élèves.</p>
  </div>
  <div>
    <a href="/affectation" class="btn btn-primary">Démarrer le placement</a>
    <a href="/eleves/importer" class="btn btn-ghost">Charger postulants (CSV)</a>
  </div>
</div>

<div class="card" style="padding:0; overflow:hidden; margin-bottom:2rem; border-color:var(--line); box-shadow:var(--shadow-strong);">
  <div style="position:relative; width:100%; height:320px; background:#0f172a;">
    <img src="https://gabonactu.com/wp-content/uploads/2026/01/Cmalia-Gabonactu.3.jpg" alt="Ministère de l'Éducation Nationale et de la Formation Professionnelle - Gabon" style="width:100%; height:100%; object-fit:cover; opacity:0.88;">
    <div style="position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.75) 100%); display:flex; flex-direction:column; justify-content:flex-end; padding:2rem;">
      <span style="display:inline-block; background:var(--gabon-green); color:#fff; font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; padding:0.25rem 0.75rem; border-radius:20px; width:fit-content; margin-bottom:0.6rem;">République Gabonaise • Enseignement Secondaire</span>
      <h2 style="color:#fff; font-size:1.75rem; font-weight:800; margin:0 0 0.4rem 0; font-family:'Fraunces', serif;">Campagne Nationale d'Orientation et d'Affectation en 6ème</h2>
      <p style="color:#e2e8f0; font-size:0.95rem; margin:0; max-width:65ch;">Plateforme officielle de pilotage, d'affectation automatisée et de gestion de la carte scolaire pour la rentrée 2026.</p>
    </div>
  </div>
</div>

<div class="releve">
  <div class="releve-item card card--gabon">
    <span class="chiffre"><%= nb_eleves %></span>
    <span class="intitule">Candidats</span>
  </div>
  <div class="releve-item card card--gabon-blue">
    <span class="chiffre"><%= nb_etablissements %></span>
    <span class="intitule">Structures</span>
  </div>
  <div class="releve-item card card--gabon-yellow">
    <span class="chiffre"><%= capacite_totale %></span>
    <span class="intitule">Capacité totale 6ème</span>
  </div>
</div>

<h2 class="section-title">Actions rapides</h2>
<div class="card">
  <p style="color:var(--texte-att);">Actions rapides: importer des dossiers, lancer une opération de placement, ou visualiser la carte des établissements. Les exports sont accessibles une fois le calcul terminé.</p>
  <div style="margin-top:1rem; display:flex; gap:0.6rem; flex-wrap:wrap;">
    <a href="/eleves/modele-csv" class="btn btn-ghost">Télécharger le modèle CSV</a>
    <a href="/carte" class="btn btn-ghost">Voir la carte</a>
    <a href="/annee-scolaire" class="btn btn-ghost">Gérer les périodes</a>
  </div>
</div>

<h2 class="section-title">État de la campagne</h2>
<div class="card">
  <div style="display:flex;gap:1rem;flex-wrap:wrap;align-items:center;justify-content:space-between;">
    <div>
      <div style="font-weight:700;font-size:1.2rem;color:var(--texte);">Affectés: <span style="color:var(--accent)"><%= nb_affectes %></span></div>
      <div style="font-weight:700;font-size:1.2rem;color:var(--texte);">En attente: <span style="color:#B56500"><%= nb_liste_attente %></span></div>
      <div style="font-weight:700;font-size:1.2rem;color:var(--texte);">Non affectés: <span style="color:#7A1F1F"><%= nb_non_affectes %></span></div>
    </div>
    <div style="min-width:260px;">
      <div style="font-size:0.9rem;color:var(--texte-att);margin-bottom:0.4rem;">Taux de remplissage global</div>
      <div class="progress-track"><div class="progress-fill" style="width:<%= taux_remplissage_global %>%;"></div></div>
      <div style="font-size:0.85rem;color:var(--texte-att);margin-top:0.4rem;"><%= taux_remplissage_global %>% des places occupées</div>
    </div>
    <div style="text-align:right;">
      <% if (has_json) { %>
        <a href="/output/rapport_affectation.json" class="btn btn-ghost">Télécharger JSON</a>
      <% } %>
      <% if (has_yaml) { %>
        <a href="/output/rapport_affectation.yaml" class="btn btn-ghost">Télécharger YAML</a>
      <% } %>
    </div>
  </div>
</div>

<h2 class="section-title">Établissements (top remplissage)</h2>
<div class="card">
  <table>
    <thead>
      <tr><th>Id</th><th>Nom</th><th>Commune</th><th>Places restantes</th><th>Taux %</th></tr>
    </thead>
    <tbody>
      <% top_etablissements.forEach(etab => { %>
        <tr>
          <td><%= etab.id %></td>
          <td><%= etab.nom %></td>
          <td><%= etab.commune %></td>
          <td><%= etab.places_restantes %></td>
          <td><%= etab.taux_remplissage %>%</td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
