<%- include('partials/header', { title: 'Nouveau dossier — ORIENT 6ÈME', annee_courante, currentPath: '/eleves' }) %>

<h1 class="display" style="font-size:2rem; margin-bottom:0.4rem;">Créer un dossier</h1>
<p style="color:var(--encre-douce); max-width:60ch; margin-bottom:2rem;">
  Le dossier sera pris en compte lors de la prochaine opération de placement.
</p>

<div class="card" style="max-width:560px;">
  <form method="POST" style="display:flex; flex-direction:column; gap:1.2rem;">

    <div style="display:flex; gap:1rem;">
      <label style="font-weight:600; font-size:0.9rem; flex:1;">
        Prénom
        <input type="text" name="prenom" required
          style="width:100%; margin-top:0.4rem; padding:0.7rem; border:1px solid var(--line); border-radius:var(--rayon-petit); font-family:inherit; font-size:0.95rem;">
      </label>
      <label style="font-weight:600; font-size:0.9rem; flex:1;">
        Nom
        <input type="text" name="nom" required
          style="width:100%; margin-top:0.4rem; padding:0.7rem; border:1px solid var(--line); border-radius:var(--rayon-petit); font-family:inherit; font-size:0.95rem;">
      </label>
    </div>

    <label style="font-weight:600; font-size:0.9rem;">
      Moyenne générale (sur 20)
      <input type="number" step="0.1" min="0" max="20" name="moyenne_generale" required
        style="width:100%; margin-top:0.4rem; padding:0.7rem; border:1px solid var(--line); border-radius:var(--rayon-petit); font-family:inherit; font-size:0.95rem;">
    </label>

    <div style="display:flex; gap:0.75rem; align-items:flex-end; position:relative;">
      <label style="font-weight:600; font-size:0.9rem; flex:1; margin-bottom:0;">
        Adresse
        <input type="text" name="adresse" id="adresse-eleve" required placeholder="ex. Quartier Glass, Libreville"
          style="width:100%; margin-top:0.4rem; padding:0.7rem; border:1px solid var(--line); border-radius:var(--rayon-petit); font-family:inherit; font-size:0.95rem;">
      </label>
      <button type="button" id="btn-geocode-eleve" class="btn btn-ghost" style="white-space:nowrap; margin-bottom:0;">Trouver GPS</button>
    </div>
    <div id="suggestions-eleve" style="display:none; position:relative; background:var(--surface); border:1px solid var(--line); border-radius:var(--rayon-petit); box-shadow:0 8px 16px rgba(0,0,0,0.08); overflow:hidden; margin-top:-0.3rem; z-index:10;"></div>
    <div id="geocode-status-eleve" style="font-size:0.8rem; color:var(--encre-douce); min-height:1.2em; margin-top:-0.4rem;"></div>

    <div style="display:flex; gap:1rem;">
      <label style="font-weight:600; font-size:0.9rem; flex:1;">
        Latitude
        <input type="number" step="0.0001" name="latitude" id="latitude-eleve" required placeholder="0.3901"
          style="width:100%; margin-top:0.4rem; padding:0.7rem; border:1px solid var(--line); border-radius:var(--rayon-petit); font-family:inherit; font-size:0.95rem;">
      </label>
      <label style="font-weight:600; font-size:0.9rem; flex:1;">
        Longitude
        <input type="number" step="0.0001" name="longitude" id="longitude-eleve" required placeholder="9.4544"
          style="width:100%; margin-top:0.4rem; padding:0.7rem; border:1px solid var(--line); border-radius:var(--rayon-petit); font-family:inherit; font-size:0.95rem;">
      </label>
    </div>

    <label style="font-weight:600; font-size:0.9rem;">
      Vœux (cliquez pour insérer des identifiants dans l'ordre de préférence)
      <div style="display:flex; gap:0.5rem; align-items:center; margin-top:0.4rem;">
        <input id="voeux-input" type="text" name="voeux" placeholder="ex. GAB001, GAB009, GAB002"
          style="flex:1; padding:0.7rem; border:1px solid var(--line); border-radius:var(--rayon-petit); font-family:inherit; font-size:0.95rem;">
        <div style="position:relative;">
          <button type="button" id="voeux-toggle" class="btn btn-ghost" style="white-space:nowrap;">Sélectionner</button>
          <div id="voeux-menu" style="display:none; position:absolute; right:0; top:calc(100% + 8px); background:var(--surface); border:1px solid var(--line); border-radius:10px; box-shadow:0 8px 20px rgba(2,6,23,0.06); max-height:240px; overflow:auto; min-width:300px; z-index:60;">
            <% etablissements.forEach(etab => { %>
              <button type="button" class="voeux-item" data-id="<%= etab.id %>" style="display:block; width:100%; text-align:left; padding:0.6rem 0.9rem; border:none; background:transparent; color:var(--text); cursor:pointer;"><%= etab.id %> — <%= etab.nom %> (<%= etab.quartier %>)</button>
            <% }) %>
          </div>
        </div>
      </div>
    </label>

    <div style="display:flex; gap:0.75rem; margin-top:0.5rem;">
      <button type="submit" class="btn btn-primary">Sauvegarder le dossier</button>
      <a href="/eleves" class="btn btn-ghost" style="color:var(--encre-douce); border-color:var(--encre-douce);">Retour</a>
    </div>
  </form>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const adresseInput = document.getElementById('adresse-eleve');
    const latitudeInput = document.getElementById('latitude-eleve');
    const longitudeInput = document.getElementById('longitude-eleve');
    const statusBox = document.getElementById('geocode-status-eleve');
    const suggestionsBox = document.getElementById('suggestions-eleve');
    const btn = document.getElementById('btn-geocode-eleve');
    let timer = null;

    function remplirAdresse(resultat) {
      adresseInput.value = resultat.label;
      latitudeInput.value = Number(resultat.latitude).toFixed(4);
      longitudeInput.value = Number(resultat.longitude).toFixed(4);
      suggestionsBox.style.display = 'none';
      suggestionsBox.innerHTML = '';
      statusBox.textContent = 'Coordonnées trouvées : ' + resultat.label;
      statusBox.style.color = 'var(--success)';
    }

    function afficherSuggestions(liste) {
      suggestionsBox.innerHTML = '';
      if (!liste || liste.length === 0) {
        suggestionsBox.style.display = 'none';
        return;
      }

      for (const item of liste) {
        const bouton = document.createElement('button');
        bouton.type = 'button';
        bouton.textContent = item.label;
        bouton.style.display = 'block';
        bouton.style.width = '100%';
        bouton.style.textAlign = 'left';
        bouton.style.padding = '0.75rem 1rem';
        bouton.style.border = 'none';
        bouton.style.borderBottom = '1px solid var(--line)';
        bouton.style.background = 'var(--surface)';
        bouton.style.cursor = 'pointer';
        bouton.style.fontSize = '0.9rem';
        bouton.style.color = 'var(--text)';
        bouton.addEventListener('click', function () {
          remplirAdresse(item);
        });
        suggestionsBox.appendChild(bouton);
      }
      suggestionsBox.style.display = 'block';
    }

    function rechercherSuggestions() {
      const adresse = (adresseInput.value || '').trim();
      if (adresse.length < 3) {
        suggestionsBox.style.display = 'none';
        suggestionsBox.innerHTML = '';
        return;
      }

      const url = new URL('/api/geocode', window.location.origin);
      url.searchParams.set('adresse', adresse);
      url.searchParams.set('mode', 'suggestions');

      fetch(url.toString())
        .then((reponse) => reponse.json())
        .then((data) => {
          if (data && data.suggestions) {
            afficherSuggestions(data.suggestions);
          }
        })
        .catch(() => {
          suggestionsBox.style.display = 'none';
        });
    }

    adresseInput.addEventListener('input', function () {
      clearTimeout(timer);
      timer = setTimeout(rechercherSuggestions, 300);
    });

    btn.addEventListener('click', async function () {
      const adresse = (adresseInput.value || '').trim();
      if (!adresse) {
        statusBox.textContent = 'Saisissez d’abord une adresse pour la recherche GPS.';
        statusBox.style.color = 'var(--danger)';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Recherche…';
      statusBox.textContent = 'Recherche des coordonnées…';
      statusBox.style.color = 'var(--encre-douce)';

      try {
        const url = new URL('/api/geocode', window.location.origin);
        url.searchParams.set('adresse', adresse);

        const reponse = await fetch(url.toString());
        const data = await reponse.json();

        if (!reponse.ok) {
          throw new Error(data.error || 'Coordonnées introuvables.');
        }

        remplirAdresse(data);
      } catch (erreur) {
        statusBox.textContent = erreur.message || 'Impossible de trouver les coordonnées.';
        statusBox.style.color = 'var(--danger)';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Trouver GPS';
      }
    });
  });
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const toggle = document.getElementById('voeux-toggle');
  const menu = document.getElementById('voeux-menu');
  const input = document.getElementById('voeux-input');

  toggle.addEventListener('click', function (e) {
    e.stopPropagation();
    menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
  });

  document.addEventListener('click', function () { menu.style.display = 'none'; });

  document.querySelectorAll('.voeux-item').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      const id = this.getAttribute('data-id');
      let current = (input.value || '').split(',').map(s => s.trim()).filter(Boolean);
      if (!current.includes(id)) current.push(id);
      input.value = current.join(', ');
      menu.style.display = 'none';
      input.focus();
    });
  });
});
</script>

<%- include('partials/footer') %>
