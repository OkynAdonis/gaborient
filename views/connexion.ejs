<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Accès — ORIENT 6ÈME</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:2rem;">
    <div class="card" style="max-width:380px; width:100%;">
      <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.75rem;">
        <span class="brand-mark" style="width:38px; height:26px;"></span>
        <div>
          <div class="display" style="font-size:1.15rem;">ORIENT 6ÈME</div>
          <div style="font-size:0.75rem; color:var(--encre-douce); text-transform:uppercase; letter-spacing:0.06em;">
            Tableau de pilotage
          </div>
        </div>
      </div>

      <% if (typeof erreur !== 'undefined' && erreur) { %>
      <p style="background:rgba(168,72,31,0.1); color:var(--danger); padding:0.7rem 1rem; border-radius:var(--rayon-petit); font-size:0.9rem; margin-bottom:1.2rem;">
        <%= erreur %>
      </p>
      <% } %>

      <form method="POST">
        <label style="font-weight:600; font-size:0.9rem; display:block; margin-bottom:1rem;">
          Clé d'accès ou année de session
          <input type="password" name="mot_de_passe" value="Gabon 2026" required autofocus
            style="width:100%; margin-top:0.4rem; padding:0.8rem; border:1px solid var(--parchemin-fonce); border-radius:var(--rayon-petit); font-family:inherit; font-size:0.95rem;">
        </label>
        <p style="font-size:0.8rem; color:var(--encre-douce); margin-bottom:1.25rem;">
          Astuce présentation : Entrez <strong>Gabon 2026</strong> ou validez directement.
        </p>
        <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; margin-bottom:0.75rem;">Se connecter</button>
        <button type="submit" name="mot_de_passe" value="Gabon 2026" class="btn btn-ghost" style="width:100%; justify-content:center; font-size:0.85rem; border-color:var(--encre-douce); color:var(--encre-douce);">Accès direct (Gabon 2026)</button>
      </form>
    </div>
  </div>
</body>
</html>
