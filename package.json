{
  "name": "gab-orient-6e",
  "version": "1.0.0",
  "description": "Plateforme d'affectation automatisée et géolocalisée des élèves de CM2 en 6ème",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "js-yaml": "^4.1.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "esbuild": "^0.21.0",
    "tsx": "^4.7.1",
    "vite": "^5.2.8"
  }
}
